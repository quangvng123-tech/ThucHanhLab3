@model IEnumerable<TourManagementWeb.Models.Entities.Payment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Duyệt hoàn tiền";
}
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="card border-0 shadow-sm rounded-4">
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr><th>Đơn</th><th>Khách hàng</th><th>Phương thức</th><th class="text-end">Số tiền</th><th>Trạng thái</th><th>Ngày tạo</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var p in Model)
            {
                <tr>
                    <td><span class="badge bg-dark">@p.Booking.BookingCode</span></td>
                    <td>@p.Booking.Customer.FullName</td>
                    <td>@p.Method</td>
                    <td class="text-end fw-bold">@p.Amount.ToString("N0") đ</td>
                    <td>
                        <span class="badge @(p.Status == "SUCCESS" ? "bg-success" : p.Status == "FAILED" ? "bg-danger" : "bg-warning text-dark")">@p.Status</span>
                    </td>
                    <td class="small text-muted">@p.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                    <td class="text-end">
                        @if (p.Status == "PENDING")
                        {
                            <form asp-controller="PaymentAdmin" asp-action="ProcessRefund" method="post" class="d-inline">
                                <input type="hidden" name="paymentId" value="@p.PaymentId" />
                                <input type="hidden" name="approve" value="true" />
                                <button class="btn btn-sm btn-success">Đã hoàn tiền</button>
                            </form>
                            <form asp-controller="PaymentAdmin" asp-action="ProcessRefund" method="post" class="d-inline ms-1">
                                <input type="hidden" name="paymentId" value="@p.PaymentId" />
                                <input type="hidden" name="approve" value="false" />
                                <button class="btn btn-sm btn-outline-danger">Từ chối</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
