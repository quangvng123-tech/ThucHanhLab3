@{
    ViewData["Title"] = "Đăng nhập hệ thống";
}
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card border-0 shadow-lg rounded-4 p-4">
                <div class="text-center mb-4">
                    <h3 class="fw-bolder text-primary">Đăng Nhập</h3>
                    <p class="text-muted small">Sử dụng tài khoản khách hàng hoặc nhân viên</p>
                </div>
                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger py-2 small">@ViewBag.Error</div>
                }
                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên đăng nhập hoặc Email</label>
                        <input type="text" name="username" class="form-control form-control-lg fs-6" required placeholder="Nhập tên đăng nhập hoặc email" />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold">Mật khẩu</label>
                        <input type="password" name="password" class="form-control form-control-lg fs-6" required placeholder="Nhập mật khẩu" />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 btn-lg fw-bold fs-6">Đăng nhập ngay</button>
                </form>
                <div class="text-center mt-3 small">
                    Chưa có tài khoản? <a asp-action="Register" class="fw-bold text-decoration-none">Đăng ký miễn phí</a>
                </div>
            </div>
        </div>
    </div>
</div>