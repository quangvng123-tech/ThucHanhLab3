<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VietTour Travel</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
        }

        .navbar-brand {
            font-weight: 800;
            font-size: 1.5rem;
            letter-spacing: -0.5px;
        }

        .nav-link {
            font-weight: 600;
            color: #334155 !important;
            transition: 0.2s;
        }

            .nav-link:hover {
                color: #0284c7 !important;
            }

        .tour-card {
            position: relative;
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.3s ease;
            border: 1px solid #e2e8f0;
            background: #fff;
        }

            .tour-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);
            }

        .tour-img-wrapper {
            position: relative;
            height: 220px;
            overflow: hidden;
        }

            .tour-img-wrapper img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }

        .tour-card:hover .tour-img-wrapper img {
            transform: scale(1.08);
        }

        .badge-category {
            position: absolute;
            top: 14px;
            left: 14px;
            background: rgba(15, 23, 42, 0.85);
            backdrop-filter: blur(4px);
            color: #fff;
            padding: 6px 12px;
            border-radius: 30px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .badge-rating {
            position: absolute;
            bottom: 12px;
            right: 12px;
            background: #fff;
            color: #f59e0b;
            padding: 4px 10px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.8rem;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
        }

        footer {
            background: #0f172a;
            color: #94a3b8;
        }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">
    <!-- Main Navbar -->
    <nav class="navbar navbar-expand-lg bg-white sticky-top shadow-sm py-3">
        <div class="container">
            <a class="navbar-brand text-primary" asp-controller="Home" asp-action="Index">
                <i class="fa-solid fa-earth-americas me-2 text-info"></i>VietTour
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">
                            <i class="fa-solid fa-compass me-1 text-primary"></i>Khám phá Tour
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Destinations">
                            <i class="fa-solid fa-map-location-dot me-1 text-success"></i>Điểm đến 3 Miền
                        </a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-2">
                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        @if (User.IsInRole("ADMIN") || User.IsInRole("STAFF"))
                        {
                            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-warning btn-sm fw-bold px-3 rounded-pill">
                                <i class="fa-solid fa-gauge-high me-1"></i>Trang Quản Trị
                            </a>
                        }
                        <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-primary btn-sm fw-semibold rounded-pill px-3">
                            <i class="fa-solid fa-suitcase-rolling me-1"></i>Đơn của tôi
                        </a>
                        <div class="dropdown ms-2">
                            <button class="btn btn-light border rounded-pill dropdown-toggle fw-semibold btn-sm px-3" data-bs-toggle="dropdown">
                                <i class="fa-regular fa-circle-user me-1 text-primary"></i>@User.Identity.Name
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0 p-3 rounded-4" style="min-width: 260px;">
                                <li class="mb-2 border-bottom pb-2">
                                    <div class="text-uppercase text-muted fw-bold" style="font-size: 0.7rem;">Thông tin cá nhân</div>
                                    <div class="fw-bold text-dark fs-6 mt-1">
                                        <i class="fa-solid fa-user text-primary me-2"></i>@User.Identity.Name
                                    </div>
                                    <div class="small text-secondary mt-1">
                                        <i class="fa-solid fa-phone text-success me-2"></i>@(User.FindFirst(System.Security.Claims.ClaimTypes.MobilePhone)?.Value ?? "0901000001")
                                    </div>
                                    <div class="small text-secondary mt-1">
                                        <i class="fa-solid fa-envelope text-danger me-2"></i>@(User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "admin@tourdemo.vn")
                                    </div>
                                    <div class="mt-2">
                                        <span class="badge bg-primary-subtle text-primary">
                                            Vai trò: @User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                                        </span>
                                    </div>
                                </li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post">
                                        <button type="submit" class="dropdown-item text-danger fw-semibold rounded-3 px-2 py-1">
                                            <i class="fa-solid fa-right-from-bracket me-2"></i>Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary fw-semibold rounded-pill px-4 btn-sm">
                            Đăng nhập
                        </a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-primary fw-semibold rounded-pill px-4 btn-sm">
                            Đăng ký
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0">
                <i class="fa-solid fa-circle-check me-2"></i>@TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>@TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <footer class="pt-5 pb-4 mt-5">
        <div class="container">
            <div class="row g-4">
                <div class="col-md-5">
                    <h5 class="text-white fw-bold mb-3"><i class="fa-solid fa-earth-americas text-info me-2"></i>VietTour Travel</h5>
                    <p class="small">Hệ thống quản lý và đặt tour du lịch trực tuyến, đảm bảo giữ chỗ thời gian thực và bảo mật thanh toán.</p>
                </div>
                <div class="col-md-3">
                    <h6 class="text-white fw-bold mb-3">Liên kết nhanh</h6>
                    <ul class="list-unstyled small">
                        <li class="mb-2"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Danh sách Tour</a></li>
                        <li class="mb-2"><a asp-controller="Home" asp-action="Destinations" class="text-decoration-none text-secondary">Điểm đến 3 Miền</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6 class="text-white fw-bold mb-3">Phương thức thanh toán</h6>
                    <div class="d-flex gap-2">
                        <span class="badge bg-primary px-3 py-2">VNPay</span>
                        <span class="badge bg-danger px-3 py-2">MoMo</span>
                        <span class="badge bg-success px-3 py-2">Tiền mặt / Chuyển khoản</span>
                    </div>
                </div>
            </div>
            <hr class="border-secondary my-4" />
            <div class="text-center small">
                &copy; 2026 VietTour Management System.
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>