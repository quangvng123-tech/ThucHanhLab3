@model IEnumerable<TourManagementWeb.Models.Entities.Review>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản Lý & Kiểm Duyệt Đánh Giá Khách Hàng";
}

<div class="mb-3 d-flex gap-2">
    <a asp-action="Reviews" class="btn btn-sm @(ViewBag.CurrentStatus == null ? "btn-dark" : "btn-outline-dark")">Tất cả (@Model.Count())</a>
    <a asp-action="Reviews" asp-route-status="PENDING" class="btn btn-sm @(ViewBag.CurrentStatus == "PENDING" ? "btn-warning" : "btn-outline-warning text-dark")">Chờ duyệt (PENDING)</a>
    <a asp-action="Reviews" asp-route-status="APPROVED" class="btn btn-sm @(ViewBag.CurrentStatus == "APPROVED" ? "btn-success" : "btn-outline-success")">Đã duyệt hiển thị (APPROVED)</a>
    <a asp-action="Reviews" asp-route-status="HIDDEN" class="btn btn-sm @(ViewBag.CurrentStatus == "HIDDEN" ? "btn-secondary" : "btn-outline-secondary")">Không duyệt / Đã ẩn (HIDDEN)</a>
</div>

<div class="card stat-card bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Khách hàng</th>
                    <th>Chương trình Tour</th>
                    <th>Số sao</th>
                    <th>Nội dung nhận xét</th>
                    <th>Ngày gửi</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Kiểm duyệt</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="fw-bold">@r.Customer?.FullName</td>
                        <td>
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@r.TourId" target="_blank" class="text-decoration-none fw-semibold">
                                @r.Tour?.TourName
                            </a>
                        </td>
                        <td class="text-warning fw-bold fs-6">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <span>@(i <= r.Rating ? "★" : "☆")</span>
                            }
                            (@r.Rating)
                        </td>
                        <td style="max-width: 320px;">@r.CommentText</td>
                        <td class="small text-muted">@r.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <span class="badge @(r.Status == "APPROVED" ? "bg-success" : r.Status == "PENDING" ? "bg-warning text-dark" : "bg-secondary")">
                                @(r.Status == "APPROVED" ? "Đã duyệt" : r.Status == "PENDING" ? "Chờ duyệt" : "Không duyệt")
                            </span>
                        </td>
                        <td class="text-end">
                            @if (r.Status != "APPROVED")
                            {
                                <form asp-action="ModerateReview" method="post" class="d-inline">
                                    <input type="hidden" name="reviewId" value="@r.ReviewId" />
                                    <input type="hidden" name="status" value="APPROVED" />
                                    <button type="submit" class="btn btn-sm btn-success fw-bold" title="Duyệt cho phép hiển thị">
                                        <i class="fa-solid fa-check"></i> Duyệt
                                    </button>
                                </form>
                            }
                            @if (r.Status != "HIDDEN")
                            {
                                <form asp-action="ModerateReview" method="post" class="d-inline ms-1">
                                    <input type="hidden" name="reviewId" value="@r.ReviewId" />
                                    <input type="hidden" name="status" value="HIDDEN" />
                                    <button type="submit" class="btn btn-sm btn-warning text-dark fw-semibold" title="Không duyệt / Ẩn khỏi Tour">
                                        <i class="fa-solid fa-eye-slash"></i> Không duyệt
                                    </button>
                                </form>
                            }
                            <form asp-action="DeleteReviewAdmin" method="post" class="d-inline ms-1" onsubmit="return confirm('Xóa vĩnh viễn đánh giá này?');">
                                <input type="hidden" name="reviewId" value="@r.ReviewId" />
                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa đánh giá">
                                    <i class="fa-solid fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>