@model IEnumerable<TourManagementWeb.Models.Entities.Contact>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Theo Dõi & Phản Hồi Liên Hệ Khách Hàng";
}
<div class="row g-3">
    @foreach (var c in Model)
    {
        <div class="col-12">
            <div class="card stat-card bg-white p-3">
                <div class="d-flex justify-content-between">
                    <div>
                        <span class="badge @(c.Status == "DONE" ? "bg-success" : "bg-warning text-dark") me-2">@c.Status</span>
                        <strong>@c.Subject</strong> - <span class="text-primary">@c.FullName (@c.Email | @c.Phone)</span>
                    </div>
                    <small class="text-muted">@c.CreatedAt.ToString("dd/MM/yyyy HH:mm")</small>
                </div>
                <p class="mt-2 mb-2 bg-light p-2 rounded small">💬 Nội dung: @c.Message</p>
                @if (c.Status == "DONE")
                {
                    <div class="small text-success"><strong>✅ Đã phản hồi:</strong> @c.Reply</div>
                }
                else
                {
                    <form asp-action="ReplyContact" method="post" class="d-flex gap-2 mt-2">
                        <input type="hidden" name="contactId" value="@c.ContactId" />
                        <input type="text" name="reply" class="form-control form-control-sm" placeholder="Nhập câu trả lời cho khách hàng..." required />
                        <button type="submit" class="btn btn-sm btn-primary px-3">Gửi phản hồi</button>
                    </form>
                }
            </div>
        </div>
    }
</div>