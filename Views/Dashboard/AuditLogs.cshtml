@model IEnumerable<TourManagementWeb.Models.Entities.AuditLog>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Nhật Ký Bảo Mật Hệ Thống (AUDIT_LOGS)";
}
<div class="card stat-card bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Log ID</th>
                    <th>Thời gian</th>
                    <th>Người thực hiện</th>
                    <th>Hành động (ACTION)</th>
                    <th>Đối tượng</th>
                    <th>Chi tiết thay đổi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var log in Model)
                {
                    <tr>
                        <td>#@log.LogId</td>
                        <td>@log.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</td>
                        <td class="fw-semibold">@(log.User?.Username ?? "System / Trigger")</td>
                        <td><span class="badge bg-dark">@log.Action</span></td>
                        <td>@log.ObjectType (#@log.ObjectId)</td>
                        <td class="text-muted">@log.Detail</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>  