@model IEnumerable<TourManagementWeb.Models.Entities.VTourStat>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Bảng Điều Khiển & Thống Kê Doanh Thu";
}

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card stat-card bg-primary text-white p-4">
            <small class="text-uppercase opacity-75 fw-bold">Tổng Doanh Thu Thực Thu</small>
            <h3 class="fw-bolder mt-2 mb-0">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) đ</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-white p-4">
            <small class="text-uppercase text-muted fw-bold">Tổng Số Đơn Đặt</small>
            <h3 class="fw-bolder text-dark mt-2 mb-0">@ViewBag.TotalBookings đơn</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-warning text-dark p-4">
            <small class="text-uppercase fw-bold">Đơn Chờ Xác Nhận</small>
            <h3 class="fw-bolder mt-2 mb-0">@ViewBag.PendingCount đơn</h3>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card bg-info text-dark p-4">
            <small class="text-uppercase fw-bold">Liên Hệ Chưa Xử Lý</small>
            <h3 class="fw-bolder mt-2 mb-0">@ViewBag.NewContacts liên hệ</h3>
        </div>
    </div>
</div>

<div class="card stat-card bg-white">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold mb-0"><i class="fa-solid fa-table me-2 text-primary"></i>Thống Kê Tình Hình Đặt Chỗ Theo Từng Tour (V_TOUR_STATS)</h6>
        <a asp-action="Bookings" class="btn btn-sm btn-primary">Xử lý đơn đặt chỗ →</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã ID</th>
                    <th>Tên Chương Trình Tour</th>
                    <th class="text-center">Tổng đơn</th>
                    <th class="text-center">Đã xác nhận</th>
                    <th class="text-center">Chờ duyệt</th>
                    <th class="text-center">Đã hủy</th>
                    <th class="text-center">Tổng hành khách</th>
                    <th class="text-end">Doanh thu (PAID)</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>#@item.TourId</td>
                        <td class="fw-bold text-primary">@item.TourName</td>
                        <td class="text-center">@item.TotalBookings</td>
                        <td class="text-center"><span class="badge bg-success">@item.ConfirmedBookings</span></td>
                        <td class="text-center"><span class="badge bg-warning text-dark">@item.PendingBookings</span></td>
                        <td class="text-center"><span class="badge bg-secondary">@item.CancelledBookings</span></td>
                        <td class="text-center fw-bold">@item.TotalPassengers khách</td>
                        <td class="text-end fw-bold text-danger">@((item.Revenue ?? 0).ToString("N0")) đ</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>